@{
    Layout = null;
    ViewData["Title"] = "二手物品交易平台-登入";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        }

        .login-wrapper {
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            width: 100%;
            max-width: 420px;
            padding: 2.5rem;
        }

        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .login-header h3 {
            font-weight: 700;
            color: #102a43;
            margin-top: 1rem;
            letter-spacing: 1px;
        }

        .login-icon {
            font-size: 3rem;
            color: #0d6efd; 
        }

        .test-account-box {
            background-color: #e0fcff;
            border-left: 4px solid #00c6d7;
            border-radius: 6px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            font-size: 0.9rem;
            color: #0c525d;
        }

        .form-control {
            border-radius: 8px;
            padding: 0.75rem 1rem;
            border: 1px solid #d9e2ec;
            background-color: #f8fbfa;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
            background-color: #ffffff;
        }

        .btn-login {
            background-color: #0d6efd;
            border: none;
            border-radius: 8px;
            padding: 0.8rem;
            font-size: 1.1rem;
            font-weight: bold;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            background-color: #0b5ed7;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="login-header">
            <i class="bi bi-person-bounding-box login-icon"></i>
            <h3>系統登入</h3>
        </div>

        <div class="test-account-box shadow-sm">
            <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i> 管理員測試帳號：</div>
            <div class="ms-4">帳號：admin</div>
            <div class="ms-4">密碼：admin</div>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger text-center shadow-sm py-2 mb-4 fw-bold" style="border-radius: 8px;" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
            </div>
        }
        <form asp-action="Login" method="post">

            <div class="mb-3">
                <label for="username" class="form-label fw-bold text-secondary small">學號 / 帳號</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" id="username" name="username" required autocomplete="off" />
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label fw-bold text-secondary small">密碼</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control border-start-0 ps-0" id="password" name="password" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-login w-100">登入</button>
            <div class="text-center mt-3">
                <span class="text-muted">還沒有帳號嗎？</span>
                <a href="~/Account/Register" class="text-decoration-none fw-bold text-primary">點我註冊</a>
            </div>
        </form>
    </div>

</body>
</html>