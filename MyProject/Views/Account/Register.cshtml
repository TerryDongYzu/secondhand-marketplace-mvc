@model MyProject.Models.Member
@{
    Layout = null;
    ViewData["Title"] = "二手物品交易平台-註冊";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .register-card { background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); padding: 3rem 2rem; width: 100%; max-width: 450px; }
        .form-control { border-radius: 8px; padding: 0.75rem 1rem; background-color: #f8f9fa; border: 1px solid #dee2e6; }
        .form-control:focus { box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15); background-color: #fff; }
    </style>
</head>
<body>

    <div class="register-card">
        <div class="text-center mb-4">
            <i class="bi bi-person-plus-fill text-primary" style="font-size: 3rem;"></i>
            <h3 class="fw-bold mt-2">加入二手物品交易平台</h3>
            <p class="text-muted">請填寫基本資料</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">學號 (登入帳號)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-123 text-muted"></i></span>
                    <input asp-for="StudentId" class="form-control border-start-0" placeholder="例如: 11316xx" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">姓名</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                    <input asp-for="Name" class="form-control border-start-0" placeholder="例如: 王小明" required />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">電子郵件 (Email)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" type="email" class="form-control border-start-0" placeholder="例如: example@yzu.edu.tw" required />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">系級</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-mortarboard text-muted"></i></span>
                    <input asp-for="Department" class="form-control border-start-0" placeholder="例如: 資管2A" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-secondary">密碼</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="設定登入密碼" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-pill mb-3">立即註冊</button>

            <div class="text-center">
                <span class="text-muted">已經有帳號了嗎？</span>
                <a href="~/Account/Login" class="text-decoration-none fw-bold text-primary">返回登入</a>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>