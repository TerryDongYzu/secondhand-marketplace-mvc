@model IEnumerable<MyProject.Models.Item>

@{
    ViewData["Title"] = "上架物品管理";
}

<div class="container mt-4">
    <h2 class="mb-4">我的物品管理</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm text-nowrap d-flex align-items-center justify-content-center" style="height: 46px;width:150px;">
            <i class="bi bi-plus-lg me-2"></i> 上架新物品
        </a>
    </p>

    @if (Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>物品名稱</th>
                        <th>分類</th>
                        <th>售價</th>
                        <th>狀態</th>
                        <th>刊登時間</th>
                        <th class="text-center">操作管理</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Title</td>
                            <td>@(item.Category != null ? item.Category.CategoryName : "無分類")</td>
                            <td class="text-danger fw-bold">$@item.Price</td>
                            <td>
                                @if (item.Status == "0")
                                {
                                    <span class="badge bg-success status-badge">上架中</span>
                                }
                                @if (item.Status == "1")
                                {
                                    <span class="badge bg-black status-badge">面交中</span>
                                }
                                @if (item.Status == "2")
                                {
                                    <span class="badge bg-secondary status-badge">已成交</span>
                                }
                            </td>
                            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-center align-middle">
                                <div class="d-flex justify-content-center align-items-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.ItemId" class="btn btn-sm btn-info text-white">查看</a>
                                    <a asp-action="Edit" asp-route-id="@item.ItemId" class="btn btn-sm btn-warning">編輯</a>
                                    <a asp-action="Delete" asp-route-id="@item.ItemId" class="btn btn-sm btn-danger">刪除</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-4 text-center">
            <h4>您目前還沒有刊登任何二手物品喔！</h4>
            <p>趕快點擊左上方的「新增物品」來清空你的宿舍吧！</p>
        </div>
    }
</div>