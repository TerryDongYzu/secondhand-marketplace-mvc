@model MyProject.Models.Item

@{
    ViewData["Title"] = "刪除確認";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">刪除物品確認</h4>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>⚠️ 嚴重警告：</strong> 您確定要刪除 <strong>「@Model.Title」</strong> 嗎？
                    </div>

                    <h5 class="fw-bold border-bottom pb-2">物品摘要資訊</h5>
                    <dl class="row mt-3 mb-0">
                        <dt class="col-sm-4 text-muted">物品編號</dt>
                        <dd class="col-sm-8">@Model.ItemId</dd>

                        <dt class="col-sm-4 text-muted">新舊狀況</dt>
                        <dd class="col-sm-8">@Model.ItemCondition</dd>

                        <dt class="col-sm-4 text-muted">售價</dt>
                        <dd class="col-sm-8 text-danger fw-bold h5">$@Model.Price</dd>

                        <dt class="col-sm-4 text-muted">刊登時間</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                    </dl>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between align-items-center p-3">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary">取消並返回</a>

                    <form asp-action="Delete" class="m-0">
                        <input type="hidden" asp-for="ItemId" />
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">確定永久刪除</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>