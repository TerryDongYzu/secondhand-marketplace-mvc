@model MyProject.Models.Item

@{
    ViewData["Title"] = "上架二手物品";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">上架二手物品</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Title" class="form-label fw-bold">物品名稱</label>
                            <input asp-for="Title" class="form-control" placeholder="請輸入物品名稱" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">物品分類</label>
                            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId" required>
                                <option value="">-- 請選擇分類 --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Price" class="form-label fw-bold">販售金額 (元)</label>
                            <input asp-for="Price" type="number" class="form-control" min="0" placeholder="0" required />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ItemCondition" class="form-label fw-bold">物品新舊狀況</label>
                            <select asp-for="ItemCondition" class="form-control" required>
                                <option value="">-- 請選擇新舊程度 --</option>
                                <option value="全新">全新</option>
                                <option value="九成新">九成新</option>
                                <option value="有使用痕跡">有使用痕跡/畫記</option>
                                <option value="堪用">堪用</option>
                            </select>
                            <span asp-validation-for="ItemCondition" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label fw-bold">物品詳細描述</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="請說明課本版本、面交限制等資訊..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4 p-3 border rounded bg-light">
                            <label class="form-label fw-bold">上傳物品照片</label>
                            <input type="file" name="files" class="form-control" accept="image/*" multiple />
                            <small class="text-muted mt-1 d-block">可按住 Ctrl 選擇多張照片</small>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">返回物品列表</a>
                            <button type="submit" class="btn btn-success px-5 fw-bold">確認上架發布</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>