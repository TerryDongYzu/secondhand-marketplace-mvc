@using X.PagedList
@using X.PagedList.Mvc.Core
@using System.Collections.Generic
@model IPagedList<MyProject.Models.Item>

@{
    Layout = null;
    ViewData["Title"] = "二手物品交易平台-大廳";

    var coverImages = (ViewBag.CoverImages as Dictionary<string, string>) ?? new Dictionary<string, string>();
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding-top: 70px; }
        .custom-navbar { background-color: #ffffff; box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05); }
        .navbar-brand { font-weight: 800; color: #2c3e50 !important; font-size: 1.4rem; }
        .nav-link { font-weight: 600; color: #7f8c8d !important; transition: color 0.2s; }
        .nav-link:hover, .nav-link.active { color: #3498db !important; }

        .item-card { background: #fff; border-radius: 12px; border: none; transition: all 0.3s ease; overflow: hidden; }
        .item-card:hover { transform: translateY(-8px); box-shadow: 0 12px 24px rgba(0,0,0,0.1) !important; }
        .card-img-box { height: 200px; width: 100%; background-color: #f8f9fa; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden;}
        .card-img-box img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .item-card:hover .card-img-box img { transform: scale(1.05); }
        .status-badge { position: absolute; top: 10px; right: 10px; padding: 0.4rem 0.8rem; border-radius: 20px; font-weight: bold; font-size: 0.8rem; box-shadow: 0 2px 5px rgba(0,0,0,0.2); z-index: 2;}

        .custom-footer { background-color: #2c3e50; color: #ecf0f1; padding: 2rem 0; margin-top: 4rem; }

        .pagination .page-link { border-radius: 8px; margin: 0 4px; }
        .pagination .active .page-link { background-color: #0d6efd; border-color: #0d6efd; color: white; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg custom-navbar fixed-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Item" asp-action="Index">二手物品交易平台</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Item" asp-action="Index"><i class="bi bi-shop me-1"></i> 大廳</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Item" asp-action="MyItems"><i class="bi bi-box-seam me-1"></i> 我的上架</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Item" asp-action="MyOrders"><i class="bi bi-receipt me-1"></i> 你的訂單</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                            <span class="text-secondary fw-bold me-3">
                                <i class="bi bi-person-circle me-1"></i> 歡迎, @(User.FindFirst("RealName")?.Value ?? User.Identity.Name)
                            </span>
                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">登出</a>
                    }
                    else
                    {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">登入</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container">

        <div class="row justify-content-center mt-4 mb-5">
            <div class="col-md-10 col-lg-8">
                <div class="d-flex gap-3 align-items-center">

                    <form asp-action="Index" method="get" class="d-flex shadow-sm flex-grow-1" style="border-radius: 50px; overflow: hidden;">
                        <span class="input-group-text bg-white border-0 ps-4 pe-2">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control border-0 py-2 shadow-none" placeholder="想找什麼酷東西？輸入物品名稱..." autocomplete="off" />
                        <button type="submit" class="btn btn-primary px-4 fw-bold border-0">搜尋</button>
                    </form>

                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm text-nowrap d-flex align-items-center" style="height: 46px;">
                        <i class="bi bi-plus-lg me-2"></i> 上架新物品
                    </a>

                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                            <div class="col">
                                <div class="card item-card shadow-sm h-100 border-0">
                            @if (item != null)
                            {
                                            <div class="card-img-box">
                                    @if (item.Status == "0")
                                    {
                                        <span class="badge bg-success status-badge">可購買</span>
                                    }
                                    else if(item.Status == "1")
                                    {
                                        <span class="badge bg-black status-badge">面交中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary status-badge">已售出</span>
                                    }

                                    @if (item.ItemId != null && coverImages.ContainsKey(item.ItemId))
                                    {
                                        <img src="@Url.Content("~" + coverImages[item.ItemId])" alt="@(item.Title ?? "商品圖片")" />
                                    }
                                    else
                                    {
                                                        <div class="text-muted text-center"><i class="bi bi-image fs-1"></i><br/>無圖片</div>
                                    }
                                            </div>

                                            <div class="card-body d-flex flex-column">
                                                <h5 class="card-title fw-bold text-truncate mb-1" title="@(item.Title ?? "無標題")">@(item.Title ?? "無標題")</h5>
                                                <p class="text-danger fw-bold fs-4 mb-2">$@(item.Price)</p>

                                                <div class="d-flex justify-content-between align-items-center mb-3 mt-auto">
                                                    <span class="badge bg-light text-dark border"><i class="bi bi-star-fill text-warning me-1"></i>@(item.ItemCondition ?? "未說明")</span>
                                                    <span class="badge bg-light text-secondary border">分類: @(item.Category?.CategoryName ?? "無分類")</span>
                                                </div>

                                                <a asp-action="Details" asp-route-id="@item.ItemId" class="btn btn-outline-primary w-100 fw-bold stretched-link">
                                                    查看詳情
                                                </a>
                                            </div>
                            }
                                </div>
                            </div>
                }
            }
            else
            {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-box-seam text-muted" style="font-size: 4rem;"></i>
                        <h4 class="text-muted mt-3 fw-bold">目前大廳空空如也</h4>
                        <p class="text-muted">試著搜尋其他關鍵字，或是成為第一個上架物品的人吧！</p>
                    </div>
            }
        </div>

        <div class="d-flex justify-content-center mt-5">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = ViewBag.CurrentFilter }), new PagedListRenderOptions
       {
           LiElementClasses = new[] { "page-item" },
           PageClasses = new[] { "page-link" },
           UlElementClasses = new[] { "pagination", "shadow-sm" },
           ActiveLiElementClass = "active",
           DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
           DisplayLinkToNextPage = PagedListDisplayMode.Always
       })
        </div>

    </div>

    <footer class="custom-footer text-center">
        <div class="container">
            <h5 class="fw-bold">二手物品交易平台</h5>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>