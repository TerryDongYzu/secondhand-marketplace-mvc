<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding-top: 90px; display: flex; flex-direction: column; min-height: 100vh; }
        main { flex: 1; }

        .custom-navbar { background-color: #ffffff; box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05); }
        .navbar-brand { font-weight: 800; color: #2c3e50 !important; font-size: 1.4rem; }
        .nav-link { font-weight: 600; color: #7f8c8d !important; transition: color 0.2s; }
        .nav-link:hover, .nav-link.active { color: #3498db !important; }

        .custom-footer { background-color: #2c3e50; color: #ecf0f1; padding: 2rem 0; margin-top: 4rem; }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg custom-navbar fixed-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Item" asp-action="Index">二手物品交易平台</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Item" asp-action="Index"><i class="bi bi-shop me-1"></i> 大廳</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Item" asp-action="MyItems"><i class="bi bi-box-seam me-1"></i> 我的上架</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Item" asp-action="MyOrders"><i class="bi bi-receipt me-1"></i> 你的訂單</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="text-secondary fw-bold me-3">
                            <i class="bi bi-person-circle me-1"></i> 歡迎, @(User.FindFirst("RealName")?.Value ?? User.Identity.Name)
                        </span>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">登出</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">登入</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mt-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="custom-footer text-center">
        <div class="container">
            <h5 class="fw-bold">二手物品交易平台</h5>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>